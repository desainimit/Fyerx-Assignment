# Copy to .env and enter credentials for an existing PostgreSQL database.
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

DB_CONFIG_HOST=localhost
DB_CONFIG_PORT=5432
DB_CONFIG_USERNAME=postgres
DB_CONFIG_PASSWORD=change-me
DB_CONFIG_DATABASE=community_events_board
DB_CONFIG_SSL=false

# Optional: defaults to true in development, false in test/production.
# SWAGGER=true
