# Copy to .env. Database values match the root docker-compose.yml.
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Required: generate a random secret; see README. No default signing key.
# The frontend (FE/.env.local) must use the same value.
JWT_SECRET=
JWT_TTL_SECONDS=3600

DB_CONFIG_HOST=localhost
DB_CONFIG_PORT=5432
DB_CONFIG_USERNAME=postgres
DB_CONFIG_PASSWORD=postgres
DB_CONFIG_DATABASE=community_events_board
DB_CONFIG_SSL=false

# Used by `npm run db:seed` to create the single admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Optional: defaults to true in development, false in test/production.
# SWAGGER=true
