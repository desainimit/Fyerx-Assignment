{
  "name": "community-events-board-backend",
  "version": "0.1.0",
  "description": "Community Events Board backend foundation",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "local": "cross-env NODE_ENV=development nest start --watch",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "build": "nest build",
    "prod": "cross-env NODE_ENV=production node dist/main.js",
    "check-types": "tsc --noEmit",
    "check-lint": "eslint .",
    "check-format": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:e2e": "cross-env NODE_ENV=test jest --config test/jest-e2e.config.cjs --runInBand",
    "test:compiled": "node test/compiled-startup.cjs",
    "make:migration": "ts-node scripts/migration.script.ts",
    "db:migrate": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/database/migrate.ts up",
    "db:migrate:status": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/database/migrate.ts status",
    "db:migrate:prod": "cross-env NODE_ENV=production node dist/database/migrate.js up",
    "db:migrate:status:prod": "cross-env NODE_ENV=production node dist/database/migrate.js status"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/swagger": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.5",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.16.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
